# --- Gemini (Google AI Studio API key: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Videomodel (Veo). Pas aan als er een nieuwere versie is.
VEO_MODEL=veo-3.1-generate-preview
# Tekstmodel voor prompts, titels en strategievoorstellen
TEXT_MODEL=gemini-2.5-flash
# Aantal clips van ~8 sec die aan elkaar worden geplakt (vereist ffmpeg bij >1)
CLIPS_PER_VIDEO=1
VIDEO_RESOLUTION=1080p

# --- YouTube ---
# OAuth client (type "Desktop app") gedownload uit Google Cloud Console
YOUTUBE_CLIENT_SECRET=client_secret.json
YOUTUBE_TOKEN_FILE=token.json
# public / unlisted / private
YOUTUBE_PRIVACY=public
YOUTUBE_CATEGORY_ID=24

# --- Planning ---
TIMEZONE=Europe/Amsterdam
GENERATE_TIME=13:00
UPLOAD_TIME=16:00
# Statistieken ophalen elke N uur
STATS_INTERVAL_HOURS=3
# Strategieën bijstellen (dag van de week + tijd)
EVOLVE_DAY=mon
EVOLVE_TIME=09:00

# --- Overig ---
DATA_DIR=data
# Zet op 1 om de planner uit te schakelen (bijv. tijdens testen)
DISABLE_SCHEDULER=0
